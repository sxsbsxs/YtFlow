# Domain name must point to this server's public IP address.
YTFLOW_DOMAIN=downloads.example.com
YTFLOW_ACME_EMAIL=you@example.com

# Initial administrator account. Use a unique password of 16+ characters.
YTFLOW_ADMIN_USERNAME=admin
YTFLOW_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Generate with: openssl rand -hex 32
YTFLOW_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32

# Optional session duration: 86400 = 24 hours (allowed: 300..604800).
YTFLOW_SESSION_TTL_SECONDS=86400

# Keep at 2 unless your server has enough CPU/network capacity.
YTFLOW_WORKERS=2
